PORT=

# MongoDB
MONGODB_URI=

# JWT
JWT_SECRET=

# Access & Refresh Tokens
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

ACCESS_TOKEN_EXPIRY=
REFRESH_TOKEN_EXPIRY=

# Session
SESSION_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=

# Nodemailer
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=

# Environment
NODE_ENV=development/production

# CORS — comma-separated list of allowed frontend origins.
# Local development: leave empty (localhost:5173 and localhost:5174 are used as defaults).
# Production example: ALLOWED_ORIGINS=https://spectrax.com,https://www.spectrax.com
ALLOWED_ORIGINS=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret configured separately in the Razorpay dashboard when
# registering the webhook URL (https://<your-domain>/webhook/razorpay,
# event: payment.captured). Distinct from RAZORPAY_KEY_SECRET above.
RAZORPAY_WEBHOOK_SECRET=

# Rate limiting — all optional. Safe defaults are used if unset:
# Auth endpoints (signup/login/OTP/forgot-password/reset-password/google-auth/refresh-token):
#   AUTH_RATE_LIMIT_WINDOW_MS default 900000 (15 min), AUTH_RATE_LIMIT_MAX default 10
# Admin login:
#   ADMIN_RATE_LIMIT_WINDOW_MS default 900000 (15 min), ADMIN_RATE_LIMIT_MAX default 10
# General API baseline (all routes):
#   API_RATE_LIMIT_WINDOW_MS default 900000 (15 min), API_RATE_LIMIT_MAX default 300
AUTH_RATE_LIMIT_WINDOW_MS=
AUTH_RATE_LIMIT_MAX=
ADMIN_RATE_LIMIT_WINDOW_MS=
ADMIN_RATE_LIMIT_MAX=
API_RATE_LIMIT_WINDOW_MS=
API_RATE_LIMIT_MAX=